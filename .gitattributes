# 换行符统一：仓库里存 LF，Windows 上的批处理检出成 CRLF
* text=auto eol=lf

# 这三类必须是 CRLF，否则 cmd.exe 会把多行连成一行
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.txt text eol=crlf

*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf

# 图片按二进制处理，别做换行转换
*.png binary
*.jpg binary
*.ico binary
*.lnk binary
